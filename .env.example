# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# Backend session/signing secret. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-secret

# Postgres credentials
POSTGRES_USER=bpmn_user
POSTGRES_PASSWORD=changeme-use-a-real-password
POSTGRES_DB=bpmn_platform

# Optional: enables live LLM-grounded agent reasoning (Stage 6).
# Leave blank to run in offline/grounded mode.
ANTHROPIC_API_KEY=

# Optional: HTTP Basic Auth for external access via a tunnel (see USAGE.md).
# Generate the actual htpasswd file separately — these are only used
# to remind you what you set, not read by docker-compose directly.
# BASIC_AUTH_USER=bart
